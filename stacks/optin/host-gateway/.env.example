# host-gateway (OPT-IN, PRIVILEGED) — copy to .env. NEVER commit .env.
#
# ⚠️  This component runs commands on the host via tiered, token-gated access.
#     It is off by default; understand the blast radius before enabling it.

# Where the component's source is built from (shipped in this repo).
HOSTGW_SRC=./src/host-gateway

# Interface the loopback admin port binds to. Keep it on 127.0.0.1 unless you
# have a specific reason and a firewall in front of it.
BIND_ADDR=127.0.0.1

# Where persistent data lives (token store, pending approvals, audit log).
AGENTSTACK_DATA=./data

TZ=UTC

# There is no token-signing secret: access tokens are random, stored only as
# hashes, and minted after the container is up with, e.g.:
#   docker exec host-gateway python hgctl.py mint sre root
# Tiers: read | operate | root | approver | none
