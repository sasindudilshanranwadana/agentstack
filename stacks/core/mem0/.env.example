# mem0 — copy to .env and fill in. NEVER commit your .env.

BIND_ADDR=127.0.0.1
PUBLIC_HOST=localhost
TZ=UTC

# Where the installer fetched the upstream mem0 source (Apache-2.0).
MEM0_SRC=./vendor/mem0

# Postgres (pgvector). REQUIRED — pick a strong password, e.g.:
#   openssl rand -hex 24
MEM0_POSTGRES_PASSWORD=

# mem0 app auth. Generate random values:
MEM0_JWT_SECRET=
MEM0_ADMIN_API_KEY=
MEM0_AUTH_DISABLED=false

# Route mem0's LLM/embedding calls through omniroute (default) or elsewhere.
MEM0_OPENAI_BASE_URL=http://omniroute:20129/v1
OPENAI_API_KEY=
