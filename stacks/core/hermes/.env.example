# hermes — copy to .env and fill in. NEVER commit your .env.

BIND_ADDR=127.0.0.1
TZ=UTC

# How Hermes reaches the rest of the stack (defaults work on the agentstack
# network; change only if you run those services elsewhere).
OMNIROUTE_BASE_URL=http://omniroute:20129
MEM0_API_URL=http://mem0-api:8000

# Hermes's chat interface (Discord bot token, upstream default interface).
HERMES_DISCORD_TOKEN=

# Optional dashboard basic-auth (recommended if you expose the dashboard).
# Generate a bcrypt hash for the password; leave blank to disable basic auth.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
