# omniroute — copy to .env and fill in. NEVER commit your .env.
#
# Bind address for published ports (default localhost-only).
# Set to 0.0.0.0 or a private/tailnet IP to expose beyond this machine.
BIND_ADDR=127.0.0.1
# Public hostname used in dashboard / websocket URLs.
PUBLIC_HOST=localhost
TZ=UTC

# OmniRoute's own API key (clients call the gateway with this) and the
# management API key (used to configure routing pools/combos).
OMNIROUTE_API_KEY=
OMNIROUTE_MGMT_API_KEY=
# Internal service token — generate a random value, e.g.:
#   openssl rand -hex 32
OMNIROUTE_INTERNAL_SERVICE_TOKEN=

# Upstream LLM provider keys (fill only the providers you selected).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
